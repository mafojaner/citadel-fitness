EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Sentry crash reporting — leave unset to disable Sentry entirely (local dev, CI)
EXPO_PUBLIC_SENTRY_DSN=https://your-key@oyour-org.ingest.sentry.io/your-project-id

# PostHog product telemetry — leave unset to disable it entirely (local dev, CI).
# Project API key from PostHog → Settings → Project. It's a write-only ingest
# key and ships in the client bundle, same as the Supabase anon key.
# Host defaults to the EU cloud, matching where Supabase and Sentry already
# keep data; override only if the PostHog project is on US cloud.
EXPO_PUBLIC_POSTHOG_KEY=phc_your-project-api-key
# EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Edge Function secrets (set via `supabase secrets set`, never committed here):
#   ADMIN_EMAIL     — your Supabase Auth login email; gates admin-dashboard-stats
#   RESEND_API_KEY  — see send-feedback-email
#   EMAIL_FROM      — see send-feedback-email
